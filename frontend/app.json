{
  "expo": {
    "name": "FamilyQuest",
    "slug": "familyquest",
    "scheme": "familyquest",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.jmartintechit.familyquest",
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.jmartintechit.familyquest"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6FAF7"
        }
      ],
      "expo-secure-store"
    ]
  }
}
